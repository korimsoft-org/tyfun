{
  "git": {
    "commitMessage": "Release: v${version}",
    "tagName": "v${version}",
    "push": true,
    "requireCleanWorkingDir": true
  },
  "npm": false,
  "github": {
    "release": false
  },
  "hooks": {
    "before:init": "pnpm test",
    "after:bump": "pnpm version ${version} --no-git-tag-version"
  }
}